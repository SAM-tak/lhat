{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "L^",
  "scopeName": "source.lhat",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#scope-specifiers" },
    { "include": "#hat-identifiers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lhat",
          "begin": "#\\[",
          "end": "\\]#",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "name": "comment.line.number-sign.lhat",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        { "include": "#string-interpolated" },
        { "include": "#string-line" },
        { "include": "#string-escaped" },
        { "include": "#string-raw" },
        { "include": "#name-literal" }
      ]
    },
    "string-interpolated": {
      "name": "string.quoted.double.interpolated.lhat",
      "begin": "\\$\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.lhat" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.lhat" } },
      "patterns": [
        { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.lhat" },
        {
          "name": "meta.interpolation.lhat",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.lhat" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.lhat" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#scope-specifiers" },
            { "include": "#hat-identifiers" },
            {
              "comment": "A plain identifier (no trailing '^') has no scope of its own otherwise, so it keeps reading as the outer string's colour -- the string.quoted.* scope this hole sits inside never goes away, TextMate scopes only stack. Giving it 'variable' explicitly is what most themes key a non-string colour off.",
              "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
              "name": "variable.other.readwrite.lhat"
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "string-line": {
      "comment": "01-lexical-structure.md 5.3: runs to the end of the line, no escapes",
      "name": "string.quoted.triple.lhat",
      "match": "\"\"\".*$"
    },
    "string-escaped": {
      "comment": "01-lexical-structure.md 5.1",
      "name": "string.quoted.double.lhat",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.lhat" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.lhat" } },
      "patterns": [
        {
          "match": "\\\\(n|r|t|0|\\\\|\"|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|\\n)",
          "name": "constant.character.escape.lhat"
        },
        { "match": "\\\\.", "name": "invalid.illegal.escape.lhat" }
      ]
    },
    "string-raw": {
      "comment": "01-lexical-structure.md 5.2: no escapes, '' denotes a single quote",
      "name": "string.quoted.single.lhat",
      "begin": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.lhat" } },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.lhat" } },
      "patterns": [
        { "match": "''", "name": "constant.character.escape.lhat" }
      ]
    },
    "name-literal": {
      "comment": "01-lexical-structure.md 3.1: an identifier spelled with backticks, cannot span a line",
      "name": "variable.other.name-literal.lhat",
      "begin": "`",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.lhat" } },
      "end": "`|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.lhat" } },
      "patterns": [
        { "match": "``", "name": "constant.character.escape.lhat" }
      ]
    },

    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9A-Fa-f_]+\\b", "name": "constant.numeric.hex.lhat" },
        { "match": "\\b0[bB][01_]+\\b", "name": "constant.numeric.binary.lhat" },
        { "match": "\\b0[oO][0-7_]+\\b", "name": "constant.numeric.octal.lhat" },
        {
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b",
          "name": "constant.numeric.float.lhat"
        },
        {
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b",
          "name": "constant.numeric.float.lhat"
        },
        { "match": "\\b[0-9][0-9_]*\\b", "name": "constant.numeric.integer.lhat" }
      ]
    },

    "annotations": {
      "comment": "02-syntax.md 18章: '@' and the name glued to it are one token (18.2), written above a declaration. The '@' carries the same scope as the name rather than one of its own -- unlike the hat, which is a mark on every keyword and stays out of the way, this one is what says an annotation is here.",
      "patterns": [
        {
          "comment": "18.3: only a literal may stand in the parentheses -- a number (a leading '-' allowed), a string, true^/false^, or a bare name. The name is the host's own constant, carried by its spelling and never resolved, so it reads as a constant rather than as anything this program declares.",
          "name": "meta.annotation.lhat",
          "begin": "(@[\\p{L}_][\\p{L}\\p{N}_]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "storage.type.annotation.lhat" },
            "2": { "name": "punctuation.bracket.lhat" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.bracket.lhat" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "match": "\\b(true|false)(\\^+)",
              "captures": {
                "1": { "name": "constant.language.lhat" },
                "2": { "name": "punctuation.definition.hat.lhat" }
              }
            },
            { "match": "[\\p{L}_][\\p{L}\\p{N}_]*", "name": "constant.other.lhat" },
            { "match": "-", "name": "keyword.operator.arithmetic.lhat" },
            { "match": ",", "name": "punctuation.separator.lhat" }
          ]
        },
        {
          "comment": "18.2: the parentheses are optional -- '@tool' takes no argument.",
          "match": "@[\\p{L}_][\\p{L}\\p{N}_]*",
          "name": "storage.type.annotation.lhat"
        }
      ]
    },

    "scope-specifiers": {
      "comment": "01-lexical-structure.md 8章: $x $$x $^x $^^x ...",
      "match": "\\$[\\$\\^]*[\\p{L}_][\\p{L}\\p{N}_]*",
      "name": "variable.language.scope.lhat"
    },

    "hat-identifiers": {
      "comment": "01-lexical-structure.md 2章: '^'-suffixed words carry every keyword. The lexer treats them all alike; the groups below are a syntax-highlighting convenience, not a lexical distinction the language itself makes. Each match splits the word from its trailing '^'s so a theme can style punctuation.definition.hat.lhat (the hat itself) separately from the word.",
      "patterns": [
        {
          "comment": "15.11's _yield^ suspends nothing but types as a yield^ does, so it reads as one here.",
          "match": "\\b(if|else|elseif|elsif|elif|ei|el|for|when|other|from|to|downto|step|in|while|until|next|skip|continue|repeat|do|break|return|yield|_yield|yieldall|await|defer|with|finally|try|catch|panic|tostring|tonumber|iterate|length|keys|values)(\\^+)",
          "captures": {
            "1": { "name": "keyword.control.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "comment": "abstract^ (14.15) and closed^ (15.13) mark what follows the way override^/overload^ do.",
          "match": "\\b(var|let|f|p|op|def|enum|pack|module|public|require|import|override|overload|abstract|closed|errordef)(\\^+)",
          "captures": {
            "1": { "name": "keyword.other.declaration.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "comment": "Self^ is a type and self^ a value -- 01 の 2.3 compares a hat word byte for byte, so the capital is a different name, matched here rather than below. 14.10改: 't^' is written with the members it asks for, and 'table^' went with the bare spelling.",
          "match": "\\b(number|string|bool|nil|any|t|c|error|Self)(\\^+)",
          "captures": {
            "1": { "name": "storage.type.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "match": "\\b(true|false)(\\^+)",
          "captures": {
            "1": { "name": "constant.language.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "match": "\\b(and|or|is|isa|as)(\\^+)",
          "captures": {
            "1": { "name": "keyword.operator.word.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "comment": "05 の 8.6's L^ names the machine; these are the hat words that name a value rather than syntax.",
          "match": "\\b(this|it|self|super|class|L)(\\^+)",
          "captures": {
            "1": { "name": "variable.language.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "comment": "9.2's clause words, each with the long spelling the parser also takes.",
          "match": "\\b(typeof|id|width|autowidth|prolog|prologue|pre|premain|first|main|last|epilog|epilogue)(\\^+)",
          "captures": {
            "1": { "name": "support.function.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        },
        {
          "comment": "Any other ^-suffixed word: 2.1's 'no reserved words' means this is legal, not a name the highlighter recognises.",
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*)(\\^+)",
          "captures": {
            "1": { "name": "keyword.other.lhat" },
            "2": { "name": "punctuation.definition.hat.lhat" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        { "match": "::|<<", "name": "invalid.deprecated.lhat" },
        { "match": "(\\+|-|\\*|/|%|//|\\*\\*|\\.\\.)=", "name": "keyword.operator.assignment.compound.lhat" },
        { "match": ":=", "name": "keyword.operator.assignment.lhat" },
        { "match": "≠|!=|=/|≦|≤|<=|≧|≥|>=", "name": "keyword.operator.comparison.lhat" },
        { "match": "=|<|>", "name": "keyword.operator.comparison.lhat" },
        { "match": "\\?\\?", "name": "keyword.operator.nil-coalescing.lhat" },
        { "match": "\\?\\.|\\?\\(|\\?\\[", "name": "keyword.operator.nil-propagation.lhat" },
        { "match": "\\.\\.\\.", "name": "keyword.operator.spread.lhat" },
        { "match": "\\.\\.", "name": "keyword.operator.concat.lhat" },
        { "match": "\\*\\*|//", "name": "keyword.operator.arithmetic.lhat" },
        { "match": "[+\\-*/%]", "name": "keyword.operator.arithmetic.lhat" },
        { "match": "!", "name": "keyword.operator.logical.lhat" },
        { "match": "\\|", "name": "keyword.operator.type.union.lhat" },
        { "match": "&", "name": "keyword.operator.type.intersect.lhat" },
        { "match": "\\.", "name": "punctuation.accessor.lhat" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "match": "[(){}\\[\\]]", "name": "punctuation.bracket.lhat" },
        { "match": "[,;:]", "name": "punctuation.separator.lhat" }
      ]
    }
  }
}
