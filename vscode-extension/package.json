{
  "name": "lhat-lsp-client",
  "displayName": "L^ (lhat) Language Support",
  "description": "Real-time type-check diagnostics for the L^ (lhat) language, via lhatls",
  "version": "0.1.0",
  "publisher": "lhat",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lhat",
        "extensions": [
          ".lh"
        ],
        "aliases": [
          "L^",
          "lhat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lhat",
        "scopeName": "source.lhat",
        "path": "./syntaxes/lhat.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "lhat.graph",
        "displayName": "L^ Graph",
        "selector": [
          {
            "filenamePattern": "*.lh"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "lhat.openGraph",
        "title": "Open Graph View",
        "category": "L^",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "comment": "Only on a .lh tab, and not on the graph's own tab -- the graph is the same resource, so resourceLangId alone would put the button on it too.",
          "command": "lhat.openGraph",
          "when": "resourceLangId == lhat && activeCustomEditorId != lhat.graph",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lhat.openGraph",
          "when": "resourceLangId == lhat"
        }
      ]
    },
    "configuration": {
      "title": "L^ (lhat)",
      "properties": {
        "lhat.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to lhatls(.exe). If empty, looks for lhatls(.exe) on PATH."
        },
        "lhat.graph.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "Open the graph view in a split beside the current editor. When off, it opens as another tab in the same editor group."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "comment": "01-lexical-structure.md 2章: every keyword is a '^'-suffixed word. The hat itself carries no meaning of its own beyond marking the word, so it stays out of the way -- a translucent grey that the editor's own background (dark or light) tints, rather than a fixed colour picked per theme.",
            "scope": "punctuation.definition.hat.lhat",
            "settings": {
              "foreground": "#88888899"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "watch:webview": "tsc -watch -p ./tsconfig.webview.json"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
