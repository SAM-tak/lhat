{
  "name": "lhat-lsp-client",
  "displayName": "L^ (lhat) Language Support",
  "description": "Real-time type-check diagnostics for the L^ (lhat) language, via lhatls",
  "version": "0.1.0",
  "publisher": "lhat",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lhat",
        "extensions": [
          ".lh"
        ],
        "aliases": [
          "L^",
          "lhat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lhat",
        "scopeName": "source.lhat",
        "path": "./syntaxes/lhat.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "L^ (lhat)",
      "properties": {
        "lhat.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to lhatls(.exe). If empty, looks for lhatls(.exe) on PATH."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "comment": "01-lexical-structure.md 2章: every keyword is a '^'-suffixed word. The hat itself carries no meaning of its own beyond marking the word, so it stays out of the way -- a translucent grey that the editor's own background (dark or light) tints, rather than a fixed colour picked per theme.",
            "scope": "punctuation.definition.hat.lhat",
            "settings": {
              "foreground": "#88888899"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
