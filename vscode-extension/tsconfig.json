{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    // Only these ambient type packages. Without this, tsc pulls in every
    // @types/* under node_modules -- and @types/react-dom / @types/d3-*
    // (React Flow's) assume the DOM lib this Node-side build does not have.
    "types": ["node"]
  },
  // The webview half builds separately (tsconfig.rf.json to typecheck,
  // esbuild to bundle): it targets a browser and uses JSX, neither of which
  // this Node-side half does.
  "include": ["src/**/*.ts"],
  "exclude": ["src/webview"]
}
