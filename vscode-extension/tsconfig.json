{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true
  },
  // The webview half builds separately (tsconfig.webview.json): it targets a
  // browser and is emitted as ES modules, which this half is not.
  "include": ["src/**/*.ts"],
  "exclude": ["src/webview"]
}
