// Typecheck only, for the React Flow half. esbuild does the emitting and
// checks nothing, so `npm run check:rf` is what catches type errors there.
{
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "types": [],
    // elkjs's own .d.ts does not survive strict indexing; not our code.
    "skipLibCheck": true
  },
  "include": ["src/webview/rf/**/*", "src/webview/map.ts", "src/protocol.ts"]
}
