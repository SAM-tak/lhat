return^ p^ rounds:number^, size:number^, seed:number^ -> number^ {
    var^ total = 0
    repeat^ rounds {
        var^ sum = seed
        var^ i = 0
        repeat^while^ i < size {
            if^ i < seed {
                sum += i + 3
                else^: sum += i + 1
            }
            i += 1
        }
        total += sum
    }
    return^ total
}
