#[
# スケジューラ — 02 の 15.14

`await^` は「中断して済んだ値を受け取る」としか言わない。誰がいつ再開するかは
言語の外であり、これがその外側である。**L^ で書けている**ことがこの単位の主張で、
ホストから借りているのは期限（`std.async.timer`）と待ち（`std.async.wait`）の2つだけ。

    let^ a = spawn(closed^p^ ... { … await^ delay(0.1) … })

走らせ方は `run()`。全部のタスクが済むまで回る。
]#

module^async

import^std.async
import^std.error
import^std.thread

#[
待てるもの = コルーチン（15.9）。`delay` は「期限を出して止まる」コルーチンを返し、
その期限 id がスケジューラまで届く。await^ が委譲なので、何段深くても届く。
]#
public^let^delay:p^number^-> c^{p^nil^ -> number^;, nil^}; = p^seconds {
    let^id = std.async.timer(seconds)
    yield^id
}

#[
別スレッドの完了を待つ（05 の 8.9・15.14）。`join()` は止まってしまうので、
`done()` で訊いて、まだなら少し `delay` する——**スケジューラは何も知らなくてよい**。
待てるものを増やすのが `delay` の上に1つ書くだけで済む、というのがこの層の要点。
]#
public^let^joined:p^std.thread.ThreadHandle -> c^{p^nil^ -> number^;,
        number^|bool^|string^|nil^
        |std.thread.ThreadError.AlreadyJoined
        |std.thread.ThreadError.BadResult
        |std.error.OutOfMemory }; = p^h {
    repeat^{
        if^h.done() { break^}
        await^delay(0.002)
    }
    return^h.join()
}

#[
タスク表。走っているコルーチンと、それが待っている期限 id を並べておく。
待っていなければ 0（`std.async.timer` は 1 から配る）。
]#
let^Scheduler = def^{
    self^{
        tasks = { },      # コルーチン
        waits = { },      # 待っている期限 id。0 なら起きている
        live  = 0,
    },

    # 走らせる。start はまだしない——run() が最初の一歩を進める
    add = p^self^, task:c^{p^nil^ -> number^;, any^}-> number^{
        self^.live += 1
        self^.tasks[self^.live] := task
        self^.waits[self^.live] := 0
        return^self^.live
    },

    # 1つ進める。答えは「まだ生きているか」
    step = p^self^, i:number^-> bool^{
        let^task = self^.tasks[i]
        if^task is^nil^{ return^false^ }

        let^asked = if^task.started(): task.resume(nil^) el^: task.start();
        if^task.done() {
            self^.tasks[i] := nil^
            self^.waits[i] := 0
            return^false^
        }
        # 出てきたものが期限 id。次に起きるのはそれが来たとき
        if^asked isa^number^{ self^.waits[i] := asked }
        return^true^
    },

    # 済んだ id を持つタスクを起こす
    wake = p^self^, done:number^{
        for^i from^1 to^self^.live {
            if^self^.waits[i] = done { self^.waits[i] := 0 }
        }
    },

    #[
    一周だけ進めて戻る。**眠らない。**
    ホスト（ゲームの主ループ、Godot の _process）は毎フレームこれを呼ぶ。

    答えは「まだ仕事が残っているか」。false なら全部済んでいる。
    ]#
    poll = p^self^-> bool^{
        var^awake = 0
        var^waiting = 0
        for^i from^1 to^self^.live {
            if^self^.tasks[i] is^nil^{ next^}
            if^self^.waits[i] = 0 {
                awake += 1
                let^_^= self^.step(i)
            else^:
                waiting += 1
            }
        }
        if^awake = 0 and^ waiting > 0 {
            # 誰も起きていない。済んでいるものだけ取る——ここでは眠らない
            let^done = std.async.wait(0)
            if^done isa^number^{ self^.wake(done) }
        }
        return^awake > 0 or^ waiting > 0
    },

    #[
    自分でループを持つ側（CLI）のための形。`poll()` を回し、
    誰も起きていなければ次の期限まで眠る——**眠るのはここだけ**である。
    ]#
    run = p^self^{
        repeat^{
            if^!self^.poll() { break^}
            var^awake = 0
            var^waiting = 0
            for^i from^1 to^self^.live {
                if^self^.tasks[i] is^nil^{ next^}
                if^self^.waits[i] = 0 {
                    awake += 1
                else^:
                    waiting += 1
                }
            }
            # 眠ってよいのは「誰も起きていない **かつ** 待っているものが在る」
            # ときだけである。待つものが無いのに眠れば、次の poll() まで
            # 何も起こらないまま止まる
            if^awake = 0 and^ waiting > 0 {
                let^done = std.async.wait(60)
                if^done isa^number^{ self^.wake(done) }
            }
        }
    },
}

public^let^make = p^-> Scheduler { return^Scheduler.new() }
