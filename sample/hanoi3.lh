import^std.task

let^workers = 6
let^depth = 5  # 2^5 = 32 タスク。細かくするほど6つのワーカーが遊ばない
let^n = 24

try^std.task.start(workers)

# 部分問題1つを1タスクにする。要るものはすべて引数で受け取る
let^piece = p^n, src, dst, aux {
    _yield^0
    let^solve = f^n, src, dst, aux {
        if^n <= 0: 0 el^: this^(n - 1, src, aux, dst) + 1 + this^(n - 1, aux, dst, src);
    }
    return^solve(n, src, dst, aux)
}

# 再帰の上 depth 段はここで辿り、底の部分問題をタスクに渡す。
# 分けるたびに挟まる1手は、どのタスクも動かさないのでここで数える
var^tasks : t^{ std.task.Task<number^>[] } = {}
var^moves = 0
let^split = p^n, src, dst, aux, depth {
    if^depth = 0 {
        tasks.push^(std.task.async(piece(n, src, dst, aux)) catch^panic^it^)
        return^
    }
    this^(n - 1, src, aux, dst, depth - 1)
    moves += 1
    this^(n - 1, aux, dst, src, depth - 1)
}
split(n, 1, 3, 2, depth)

for^task in^tasks {
    moves += try^std.task.await(task)
}
print(moves)
std.task.stop()
