let^C = p^{ yield^}

print(typeof^(C).signature)

let^c = C()

print(typeof^(c.start).signature)
print(typeof^(c.resume).signature)

let^Logged = def^{
    self^{
        abstract^n : number^
    },
    override^run = p^self^{
        self^.n += 10
        super^()
    }
}
let^AppBase = def^{
    self^{
        n = 0
    },
    run = p^self^{
        self^.n += 1
    }
}
let^App = AppBase..Logged
let^app = App.new()
app.run()
print(app.n)
print(App)
print(typeof^(App).signature)

let^isEven = f^x {
    for^let^x:number^= x
    for^x % 2:
        when^0: true^
        other^: false^ # when^1を書いてもother^が必要。これ具合悪いね
    ;
}
print(isEven(6))
print(isEven(9))

let^isEvenStr = f^x:number^{
    for^isEven(x):
        when^true^: "even"
        when^false^: "odd"
    ;
}
print(isEvenStr(6))
print(isEvenStr(9))

let^match = p^x:string^{
    for^x {
    when^"aaa", "bbb":
        print($"{it^}")
    }
    print($"{x} end")
}
match("aaa")
match("bbb")
match("ccc")

