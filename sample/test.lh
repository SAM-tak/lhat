let^A = def^{
    self^{ a = 0, b = 0, },
    overload^new = f^a, b { self^{ a = a, b = b } },
    overload^new = f^a { self^{ a = a, b = a } },
    add = f^self^, rhs:Self^ -> Self^ { self^ },
    op^* = f^self^, rhs:number^{ def^.new(self^.a * rhs, self^.b * rhs) },
    overload^op^* = f^lhs:number^, self^{ def^.new(lhs * self^.a, lhs * self^.b) },
    somestatic = p^{ print("aaa") },
    name = "A"
}
let^B = A..def^{
    override^name = "B"
}
print(typeof^(A).signature)
#[
t^{
    self^{
        * : f^self^, number^ -> Self^; & f^number^, self^ -> Self^;,
        a : number^, add : f^self^, Self^ -> Self^;,
        b : number^
    },
    new : f^ -> Self^; & f^number^, number^ -> Self^; & f^number^ -> Self^;,
    somestatic : p^;
}
]#
let^aA = A.new(1, 3)
print(typeof^(aA).signature)
print(aA)

let^bA = A.new(2)
print(bA)

let^cA = A.new()
print(cA)

let^aB = B.new()
print("aB", aB)

let^ATest = f^x:A, y { x * y }
print(ATest(aA, 3))
# let^ATest2 = f^x, y { x * y } # 期待通りエラー
# several types here carry this operator and nothing says which is meant;
# write one of the types the signature names, or narrow to it with fits^
# let^ATest2 = f^x, y {
#     if^x fits^A: x * y el^: x * y;
# } # 残念これは通らない
# let^ATest2 = f^x, y {
#     if^x fits^A: x * y el^x fits^number^: x * y el^: A.new();
# } # 残念これも通らない
let^ATest2 = f^x:A|number^, y { # これは行ける。まぁ許容範囲かな。
    if^x fits^A: x * y el^: x * y;
}
print(ATest2(aA, 3))
print(ATest2(4, 3))

let^_a = f^n{ if^n <= 0 { return^true^} return^_b(n - 1) }
let^_b = f^n{ if^n <= 0 { return^false^} return^_a(n - 1) }

print(typeof^(_a).signature)
print(typeof^(_b).signature)

