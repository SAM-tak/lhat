if^ f? {
    print("aaaa")
el^:
    print("aaaa")
}

print(if^ f?: 1 el^: 0;)

let^b = "aaa"

if^ f? {
    print("aaaa")
el^ b?:
    print("bbbb")
el^:
    print("cccc")
}

print(if^ f?: 1 elif^b?: 2 else^: 3;)

let^iii = {aaaaa = "aaa", "bbb"}.tostring^
print(iii)

let^A = def^{
    self^{ a = 0, b = 0, },
    overload^new = f^a, b { self^{ a := a, b := b } },
    overload^new = f^a { self^{ a := a, b := a } },
    add = f^self^, rhs:Self^ -> Self^ { self^ },
    somestatic = p^{ print("aaa") }
}
print(typeof^(A).signature)

let^aA = A.new(1, 3)
print(typeof^(aA).signature)
print(aA)

let^bA = A.new(2)
print(bA)

let^cA = A.new()
print(cA)

let^_a = f^n{ if^n <= 0 { return^true^} return^_b(n - 1) }
let^_b = f^n{ if^n <= 0 { return^false^} return^_a(n - 1) }

print(typeof^(_a).signature)
print(typeof^(_b).signature)

let^t = {aaaaa = "aaa", bbb = "bbb", あああ = "0"}
print(t)
print(typeof^(t).signature)
print(t.aaaaa)
print(t["aaaaa"])
print(t.bbb)
print(t["bbb"])
print(t.あああ)
print(t["あああ"])
print(t[1])
