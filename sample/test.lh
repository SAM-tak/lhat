let^f = f^ { (1, 2) }
let^g = f^x, y { x + y }
let^h = f^x, y, z { x + y + z }

print(
    for^let^x, y = f()
    for^let^z = g(x, y)
    do^:h(x, y, z);
)

print("spread", f()...)
print("pack", pack^f())
print(typeof^(f))
print(typeof^(f).signature)

for^let^u:number^ = 0
for^let^v:number^ = 1
if^ u = 0 {
    print("sdsad", v)
else^:
    print("!!!")
}

let^u:number^ = 0
let^v:number^ = 0
if^ u = 0 and^ v = 0 {
    print("sdsad")
else^:
    print("!!!")
}

