if^!nil^?   { print("1 falsy") } #=> falsy L^では nil^だけ
if^!true^?  { print("2 falsy") } # 何も出力されない
if^!false^? { print("3 falsy") } # 何も出力されない
if^!0?      { print("4 falsy") } # 何も出力されない
if^!""?     { print("5 falsy") } # 何も出力されない

