import^std.task
import^std.channel

try^std.task.start(2)

let^gen1 = p^{ yield^0 return^40 }
let^gen2 = p^{ yield^0 return^2 }

let^t1 = try^std.task.async(gen1())
let^t2 = try^std.task.async(gen2())
var^n = 0
n += try^std.task.await(t1)
n += try^std.task.await(t2)
print(n) # may print '42'

#[~
let^c = try^std.channel.new(std.task.Task<number^>)
]#
let^c = try^std.channel.new(typeof^t1)
n := 0
let^first = try^std.task.async(p^{
    return^20
})
try^c.push(first)
let^addnumber = 1
let^second = try^std.task.async(p^{
    let^handed = c.demand(2)
    return^ if^handed?: std.task.await(handed) catch^ 0 + addnumber el^: 0;
})
n := try^std.task.await(second)
print(n) # may print '21'

std.task.stop()
