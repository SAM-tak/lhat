file(MAKE_DIRECTORY "${WORK}")
set(ENV{LHAT_CLI_EXTENSION_LOG} "${WORK}/lifetime.txt")
file(WRITE "${WORK}/lifetime.txt" "")
# Put the dependent extension first to prove all TYPES precede MEMBERS.
execute_process(COMMAND "${CLI}" --language ja --dump-host-api "${WORK}/host.json"
    --extension "${PEER}" --extension "${PROBE}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Extension dump failed: ${error}")
endif()
file(READ "${WORK}/host.json" json)
string(JSON size LENGTH "${json}" functions)
set(found "")
math(EXPR last "${size} - 1")
foreach(i RANGE ${last})
    string(JSON module ERROR_VARIABLE missing GET "${json}" functions ${i} module)
    if(NOT missing AND module MATCHES "^cli_(probe|peer)$")
        list(APPEND found "${module}")
    endif()
endforeach()
list(SORT found)
if(NOT "${found}" STREQUAL "cli_peer;cli_probe")
    message(FATAL_ERROR "Missing extension signatures: ${found}")
endif()
file(STRINGS "${WORK}/lifetime.txt" lifetime)
list(GET lifetime 0 first)
list(GET lifetime 1 second)
list(GET lifetime 2 third)
list(GET lifetime 3 fourth)
if(NOT first MATCHES " program$" OR NOT second MATCHES " program$"
    OR NOT third STREQUAL "cli_probe shutdown" OR NOT fourth STREQUAL "cli_peer shutdown")
    message(FATAL_ERROR "Wrong teardown order: ${lifetime}")
endif()
# A failed load must not overwrite an existing output file.
file(WRITE "${WORK}/keep.json" "unchanged")
execute_process(COMMAND "${CLI}" --dump-host-api "${WORK}/keep.json" --extension "${WORK}/absent.dll"
    RESULT_VARIABLE result ERROR_VARIABLE error)
file(READ "${WORK}/keep.json" kept)
if(result EQUAL 0 OR NOT kept STREQUAL "unchanged" OR NOT error MATCHES "Could not load")
    message(FATAL_ERROR "Missing library was not handled correctly: ${error}")
endif()
execute_process(COMMAND "${CLI}" --dump-host-api --extension RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "requires a library path")
    message(FATAL_ERROR "Missing option value was not rejected")
endif()
execute_process(COMMAND "${CLI}" --extension "${PROBE}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "with --dump-host-api")
    message(FATAL_ERROR "Unsupported mode must not silently ignore extensions")
endif()
execute_process(COMMAND "${CLI}" --dump-host-api --extension "${PROBE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
string(JSON strict ERROR_VARIABLE json_error GET "${json}" strict)
if(NOT result EQUAL 0 OR json_error)
    message(FATAL_ERROR "stdout is not valid JSON: ${error} / ${json_error}")
endif()
