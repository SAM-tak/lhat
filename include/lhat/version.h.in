// L^ (lhat) -- generated by CMake from include/lhat/version.h.in; do not
// edit the generated file.

#ifndef LHAT_VERSION_H
#define LHAT_VERSION_H

#define LHAT_VERSION "@PROJECT_VERSION@"
#define LHAT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define LHAT_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define LHAT_VERSION_PATCH @PROJECT_VERSION_PATCH@

// 01 の 6.4: whether comments are kept and attached to the syntax tree. It
// changes the shape of LhatLexer and LhatNode, so it lives in a header
// rather than in a compile definition -- every translation unit that can
// see those structs then agrees on their layout by construction, installed
// consumers included.
#define LHAT_WITH_COMMENTS @LHAT_WITH_COMMENTS_VALUE@

// 07 の 4 章: whether the checker records what each written name resolved to.
// Nothing in the language reads it -- compiling and running are the same
// either way -- and it is kept for the language server, which would
// otherwise have to work 8 章's scoping out a second time. It changes the
// shape of LhatCheckResult, so it lives here for the reason above.
#define LHAT_WITH_RESOLUTIONS @LHAT_WITH_RESOLUTIONS_VALUE@

// 09 章: whether the VM carries a debugger -- the line hook, the frame
// inspection API (lhat/debug.h) and the machine watcher. Off, a shipping
// build compiles none of it, the way GDScript's release build does. It
// changes the shape of LhatMachine, so it lives here for the reason above.
#define LHAT_WITH_DEBUGGER @LHAT_WITH_DEBUGGER_VALUE@

// 05 の 10.8: whether the front end -- lexer, parser, checker, compiler --
// is in the library. Off, a program reads binary units (10 章) and
// registers a host by the signature table (10.7); a text unit, a std.load,
// a prompt, an expression under the debugger are refused as "no front
// end". Nothing's layout changes, but what a call answers does, so an
// installed consumer wants the same value the library was built with.
#define LHAT_WITH_FRONTEND @LHAT_WITH_FRONTEND_VALUE@

#endif  // LHAT_VERSION_H
