[configuration]

entry_symbol = "lhat_library_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "res://bin/liblhat.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/liblhat.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/liblhat.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/liblhat.windows.template_release.arm64.dll"
linux.debug.x86_64 = "res://bin/liblhat.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liblhat.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/liblhat.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/liblhat.linux.template_release.arm64.so"
macos.debug.x86_64 = "res://bin/liblhat.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://bin/liblhat.macos.template_release.x86_64.dylib"
macos.debug.arm64 = "res://bin/liblhat.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/liblhat.macos.template_release.arm64.dylib"
