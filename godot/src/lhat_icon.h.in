// L^ (lhat) -- the extension's own icon, as SVG source.
//
// Generated by CMake from godot/lhat-script.svg. Embedded rather than loaded
// from res://: the icon is the extension's face and has to be there in any
// project it is added to, and a path into one project's files would not be.
// The engine's own editor icons are carried the same way -- SVG source,
// rasterised at whatever scale the editor is running at.
//
// godot/demo/lhat/ has a copy of the same drawing. That one is a project
// resource demonstrating @icon, which is a different job: this names what a
// .lh is, that one names what one class is.

#ifndef LHAT_GODOT_ICON_H
#define LHAT_GODOT_ICON_H

static const char *const LHAT_SCRIPT_ICON_SVG = R"LHATSVG(@LHAT_SCRIPT_ICON_SVG@)LHATSVG";

#endif  // LHAT_GODOT_ICON_H
